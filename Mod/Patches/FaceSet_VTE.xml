						<FacialAnimation.LidTypeDef>
							<defName>OL_SerenLidFlirtyFA</defName>
							<texPath>Things/Pawn/Seren/Lids/Flashy</texPath>
							<probability>1</probability>
							<shader>Map/Transparent</shader>
							<targetGeneDefs><li>OL_SerenEyes</li></targetGeneDefs>
						</FacialAnimation.LidTypeDef>

						<FacialAnimation.LidTypeDef>
							<defName>OL_SerenLidStuffedFA</defName>
