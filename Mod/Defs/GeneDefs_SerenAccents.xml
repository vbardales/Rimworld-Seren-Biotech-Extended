<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- The pale second colour of the original Seren mod (race colour channel "skin", second colour), one gene per tone. The original drew it at random; here it is chosen. It tints the original horns and body masks of this mod. -->
	<GeneDef Name="GeneSerenAccentBase" Abstract="True">
		<biostatCpx>0</biostatCpx>
		<displayCategory>Cosmetic</displayCategory>
		<iconPath>UI/Icons/Genes/Gene_SerenMarkingSmall</iconPath>
		<exclusionTags>
			<li>SerenAccentColor</li>
		</exclusionTags>
	</GeneDef>

	<GeneDef ParentName="GeneSerenAccentBase">
		<defName>SerenAccent_Pearl</defName>
		<label>pearl accent</label>
		<description>Carriers of this gene have horns and body masks of the original Seren mod in a pale pearl tone.</description>
		<iconColor>(255, 255, 255)</iconColor>
		<displayOrderInCategory>121</displayOrderInCategory>
		<modExtensions>
			<li Class="SerenBiotechExtended.AccentColorExtension">
				<color>(255, 255, 255)</color>
			</li>
		</modExtensions>
	</GeneDef>

