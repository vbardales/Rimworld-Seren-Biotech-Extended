<Defs>

	<!-- Body masks of the original Seren mod (2704627783), redrawn as RGBA textures for the Biotech fork. Same exclusion tag as the fork's own masks (SerenBodyMask), so only one body mask is worn. -->

	<GeneDef ParentName="GeneSerenBodyMaskBase">
		<defName>SerenOriginalMask_0</defName>
		<label>original body mask 0</label>
		<description>Carriers of this gene wear body mask 0 of the original Seren mod.</description>
		<renderNodeProperties>
			<li>
				<debugLabel>Seren original body mask 0</debugLabel>
				<nodeClass>SerenBiotechExtended.PawnRenderNode_AccentBody</nodeClass>
				<workerClass>SerenBiotechExtended.PawnRenderNodeWorker_MaskBody</workerClass>
				<texPath>Things/SerenBiotechExtended/Mask0</texPath>
				<bodyTypeGraphicPaths>
					<li><Child>Things/SerenBiotechExtended/Mask0_Fit</Child></li>
					<li><Baby>Things/SerenBiotechExtended/Mask0_Fit</Baby></li>
				</bodyTypeGraphicPaths>
				<baseLayer>5</baseLayer>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<colorType>Custom</colorType>
				<color>(235, 238, 255)</color>
				<parentTagDef>Body</parentTagDef>
			</li>
		</renderNodeProperties>
	</GeneDef>

