<Defs>

	<!-- Head horns of the original Seren mod (2704627783), styles 0 to 7, as genes of the Biotech fork. Same exclusion tag as the fork's sensors (SerenSensors): only one pair of horns is worn. -->

	<GeneDef ParentName="GeneSerenSensorBase">
		<defName>SerenOriginalHorns_0</defName>
		<label>original seren horns 0</label>
		<description>Carriers of this gene have the horns of style 0 of the original Seren mod.</description>
		<iconPath>UI/Icons/Genes/Gene_BackSensors</iconPath>
		<renderNodeProperties>
			<li>
				<debugLabel>Seren original left horn 0</debugLabel>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/SerenBiotechExtended/Horns/HornLeft0</texPath>
				<color>(255, 255, 255)</color>
				<parentTagDef>Head</parentTagDef>
				<drawData>
					<defaultData>
						<layer>80</layer>
					</defaultData>
					<dataNorth>
						<layer>10</layer>
					</dataNorth>
				</drawData>
			</li>
			<li>
				<debugLabel>Seren original right horn 0</debugLabel>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/SerenBiotechExtended/Horns/HornRight0</texPath>
				<color>(255, 255, 255)</color>
				<parentTagDef>Head</parentTagDef>
				<drawData>
					<defaultData>
						<layer>80</layer>
					</defaultData>
					<dataNorth>
						<layer>10</layer>
					</dataNorth>
				</drawData>
			</li>
		</renderNodeProperties>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>pointed</symbol></li>
				<li><symbol>sharp</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>sensor</symbol></li>
				<li><symbol>horn</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

